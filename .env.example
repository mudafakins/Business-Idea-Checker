# The AI runs through your Claude subscription by default, using the `claude`
# command-line tool. Log in once: run `claude` in Terminal and type /login.
#
# To use the Claude API instead (faster, pay as you go), paste a key here.
# Keys come from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model overrides
# CONDUCTOR_MODEL=claude-opus-5-5      (when using the API key)
# CONDUCTOR_CLI_MODEL=opus             (when using the subscription: opus, sonnet or haiku)
